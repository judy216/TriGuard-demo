    def refresh_finance(self):
        t = TR.get(getattr(self,"_current_lang","ar"), TR["ar"])
        """تحديث جميع القوائم المالية"""
        if not hasattr(self, "bs_frame"):
            return
        conn = get_connection()
        cur  = conn.cursor()

        # ── بيانات المركز المالي ──
        cur.execute("""SELECT COALESCE(SUM(amount_dr),0) FROM journal_entries
                       WHERE account_dr='المخزون / بضاعة'""")
        inventory = cur.fetchone()[0]

        cur.execute("""SELECT COALESCE(SUM(amount_dr),0) FROM journal_entries
                       WHERE account_dr='مصروف المشتريات'""")
        purchases_exp = cur.fetchone()[0]

        cur.execute("""SELECT COALESCE(SUM(amount_cr),0) FROM journal_entries
                       WHERE account_cr='الذمم الدائنة (موردون)'""")
        payables = cur.fetchone()[0]

        cur.execute("""SELECT COALESCE(SUM(amount_cr),0) FROM journal_entries
                       WHERE account_cr='النقدية / البنك'""")
        cash_out = cur.fetchone()[0]

        # رأس المال الافتراضي
        equity_capital = 12000000.0
        cash_balance   = max(equity_capital - cash_out, 0)
        total_assets   = cash_balance + inventory
        total_liab     = payables
        equity         = total_assets - total_liab

        # ── بيانات قائمة الدخل ──
        cur.execute("SELECT COALESCE(SUM(amount_dr),0) FROM journal_entries WHERE account_dr='مصروف المشتريات'")
        total_purchases = cur.fetchone()[0]
        # إيرادات افتراضية (120% من المشتريات)
        revenue     = total_purchases * 1.20
        gross_prof  = revenue - total_purchases
        other_exp   = revenue * 0.05   # مصاريف تشغيل 5%
        net_income  = gross_prof - other_exp

        # ── قيود ──
        cur.execute("""SELECT entry_date,description,account_dr,amount_dr,
                              account_cr,amount_cr,entry_type
                       FROM journal_entries ORDER BY entry_id DESC""")
        journal_rows = cur.fetchall()
        conn.close()

        # ════ رسم قائمة المركز المالي ════
        for w in self.bs_frame.winfo_children():
            w.destroy()

        def fin_section(parent, title, color):
            f = tk.Frame(parent, bg=COLORS["surface"],
                         highlightbackground=color, highlightthickness=2)
            f.pack(fill="x", padx=20, pady=6)
            tk.Label(f, text=title, font=("Arial",11,"bold"),
                     fg="white", bg=color).pack(fill="x", padx=0, pady=0, ipadx=10, ipady=6)
            return f

        def fin_row(parent, label, amount, indent=0, bold=False, color="#111111", total=False):
            bg = "#f0f0f0" if total else COLORS["surface"]
            f  = tk.Frame(parent, bg=bg)
            f.pack(fill="x", padx=2, pady=(0,1))
            if total:
                tk.Frame(f, bg=COLORS["border"], height=1).pack(fill="x")
            font = ("Arial",10,"bold") if (bold or total) else ("Arial",9,"bold")
            tk.Label(f, text=f"{'    '*indent}{label}",
                     font=font, fg=color, bg=bg, anchor="e").pack(side="right", padx=(10,16), pady=4)
            _disp_amt = abs(amount)
            amt_color = COLORS["success"] if amount >= 0 else COLORS["error"]
            tk.Label(f, text=f"{_disp_amt:>14,.2f}  ريال",
                     font=font, fg=amt_color if not bold else color, bg=bg, anchor="w").pack(side="left", padx=16, pady=4)

        tk.Label(self.bs_frame,
                 text=f"{t['bs_date']} {date.today()}",
                 font=("Arial",13,"bold"), fg="#000000",
                 bg=COLORS["bg"]).pack(pady=(16,6))

        # الأصول
        assets_sec = fin_section(self.bs_frame, t["assets"] if "assets" in t else "الأصول  ASSETS", COLORS["accent"])
        tk.Label(assets_sec, text=t["assets_cur"], font=("Arial",9,"bold"),
                 fg="#000000", bg=COLORS["surface"]).pack(anchor="e", padx=16, pady=(8,2))
        fin_row(assets_sec, t["cash"],      cash_balance,  indent=1)
        fin_row(assets_sec, t["inventory"],     inventory,     indent=1)
        fin_row(assets_sec, t["total_assets"],       total_assets,  bold=True, total=True,
                color=COLORS["accent2"])

        # الالتزامات
        liab_sec = fin_section(self.bs_frame, t["liabilities"] if "liabilities" in t else "الالتزامات  LIABILITIES", COLORS["error"])
        tk.Label(liab_sec, text=t["liab_cur"], font=("Arial",9,"bold"),
                 fg="#000000", bg=COLORS["surface"]).pack(anchor="e", padx=16, pady=(8,2))
        fin_row(liab_sec, t["payables"], payables, indent=1)
        fin_row(liab_sec, t["total_liab"],      total_liab,  bold=True, total=True,
                color=COLORS["error"])

        # حقوق الملكية
        eq_sec = fin_section(self.bs_frame, t["equity_title"] if "equity_title" in t else "حقوق الملكية  EQUITY", COLORS["success"])
        fin_row(eq_sec, t["capital"],           equity_capital, indent=1)
        fin_row(eq_sec, t["retained"],    equity - equity_capital, indent=1,
                color=COLORS["success"] if (equity-equity_capital)>=0 else COLORS["error"])
        fin_row(eq_sec, t["total_equity"], equity, bold=True, total=True,
                color=COLORS["success"])

        # معادلة المحاسبة
        balanced = abs(total_assets - (total_liab + equity)) < 1
        _en_eq = getattr(self,"_current_lang","ar")=="en"
        eq_label = ("✅ Balanced" if balanced else "⚠️ Not Balanced") if _en_eq else ("✅ الميزانية متوازنة" if balanced else "⚠️ الميزانية غير متوازنة")
        eq_color = COLORS["success"] if balanced else COLORS["error"]
        tk.Label(self.bs_frame, text=f"{eq_label}   |   {t['assets']}={total_assets:,.0f} | {t['liab_cur']}+{t['equity']}={total_liab+equity:,.0f}",
                 font=("Arial",9,"bold"), fg=eq_color,
                 bg=COLORS["bg"]).pack(pady=10)

        # ════ رسم قائمة الدخل ════
        for w in self.is_frame.winfo_children():
            w.destroy()

        tk.Label(self.is_frame,
                 text=f"{t['is_date']} {date.today()}",
                 font=("Arial",13,"bold"), fg="#000000",
                 bg=COLORS["bg"]).pack(pady=(16,6))

        is_sec = fin_section(self.is_frame, t["pl_title"] if "pl_title" in t else "الإيرادات والمصروفات  P&L", "#6366f1")
        fin_row(is_sec, t["revenue"],   revenue,         indent=1, color=COLORS["success"])
        fin_row(is_sec, t["cogs"],   -total_purchases, indent=1, color=COLORS["error"])
        fin_row(is_sec, t["gross_profit"],                   gross_prof,      bold=True, total=True,
                color=COLORS["success"] if gross_prof>=0 else COLORS["error"])
        fin_row(is_sec, t["op_exp"], -other_exp,      indent=1, color=COLORS["error"])
        net_color = COLORS["success"] if net_income >= 0 else COLORS["error"]
        fin_row(is_sec, t["net_income"],       net_income,
                bold=True, total=True, color=net_color)

        # أثر كل عملية
        tk.Label(self.is_frame,
                 text=t["op_effect"],
                 font=("Arial",10,"bold"), fg="#000000",
                 bg=COLORS["bg"]).pack(anchor="e", padx=20, pady=(16,4))

        effect_frame = tk.Frame(self.is_frame, bg=COLORS["surface"],
                                highlightbackground=COLORS["border"], highlightthickness=1)
        effect_frame.pack(fill="x", padx=20, pady=(0,10))

        _en_h = getattr(self,"_current_lang","ar")=="en"
        headers = (
            ["PO", t["col_item"], "Amount", "Balance Sheet Effect", "Income Statement Effect"]
            if _en_h else
            ["الأمر", t["col_item"], "المبلغ", "أثر المركز المالي", "أثر قائمة الدخل"]
        )
        hrow = tk.Frame(effect_frame, bg=COLORS["accent"])
        hrow.pack(fill="x")
        for h, w in zip(headers, [80,130,100,200,200]):
            tk.Label(hrow, text=h, font=("Arial",9,"bold"), fg="white",
                     bg=COLORS["accent"], width=w//7, anchor="center").pack(side="left", padx=1, pady=5)

        conn2 = get_connection()
        cur2  = conn2.cursor()
        cur2.execute("""
            SELECT p.po_number, p.item_name, j.amount_dr
            FROM journal_entries j JOIN purchase_orders p ON j.po_id=p.po_id
            WHERE j.account_dr='المخزون / بضاعة'
            ORDER BY j.entry_id DESC
        """)
        for i, r in enumerate(cur2.fetchall()):
            bg = COLORS["bg"] if i%2==0 else COLORS["surface"]
            row_f = tk.Frame(effect_frame, bg=bg)
            row_f.pack(fill="x")
            _en_eff = getattr(self,"_current_lang","ar")=="en"
            vals = [
                r[0],
                r[1],
                f"ريال {r[2]:,.0f}",
                (f"↑ Inventory +{r[2]:,.0f}  |  ↑ Payables +{r[2]:,.0f}"
                 if _en_eff else f"↑ مخزون +{r[2]:,.0f}  |  ↑ موردون +{r[2]:,.0f}"),
                (f"↑ COGS +{r[2]:,.0f}  ↓ Profit"
                 if _en_eff else f"↑ تكلفة مبيعات +{r[2]:,.0f}  ↓ ربح"),
            ]
            colors2 = [COLORS["text"],COLORS["text"],COLORS["accent2"],
                      COLORS["warning"],COLORS["error"]]
            widths2 = [80,130,100,200,200]
            for val, vc, w in zip(vals, colors2, widths2):
                tk.Label(row_f, text=val, font=("Arial",8,"bold"), fg=vc,
                         bg=bg, width=w//7, anchor="center").pack(side="left", padx=1, pady=4)
        conn2.close()

        # ════ تحديث جدول القيود ════
        if hasattr(self, "jnl_tree"):
            for r in self.jnl_tree.get_children():
                self.jnl_tree.delete(r)
            TYPE_AR = {"balance_sheet":"مركز مالي","income_statement":"قائمة دخل"}
            for row in journal_rows:
                type_ar = TYPE_AR.get(row[6],"—")
                self.jnl_tree.insert("", "end",
                    values=(row[0],row[1],row[2],f"{row[3]:,.2f}",row[4],f"{row[5]:,.2f}",type_ar))

