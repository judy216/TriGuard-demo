                    os.startfile(filepath)
            except Exception as e:
                messagebox.showerror(t["err_title"], str(e))

    def _scan_invoice(self):
        """قراءة فاتورة من صورة أو PDF واستخراج البيانات تلقائياً"""
        t = TR.get(getattr(self,"_current_lang","ar"), TR["ar"])
        fp = filedialog.askopenfilename(
            title="اختر صورة أو PDF للفاتورة",
            filetypes=[
                ("صور وPDF", "*.jpg *.jpeg *.png *.pdf *.bmp *.tiff"),
                ("صور", "*.jpg *.jpeg *.png *.bmp *.tiff"),
                ("PDF", "*.pdf"),
                ("All", "*.*")
            ]
        )
        if not fp:
            return
        try:
            try:
                from PIL import Image
                import pytesseract, re
            except ImportError:
                messagebox.showwarning("تثبيت مطلوب",
                    "لاستخدام هذه الميزة ثبّتي المكتبات التالية:\n\n"
                    "pip3 install pytesseract pillow\n"
                    "brew install tesseract\n\n"
                    "ثم أعيدي تشغيل البرنامج.")
                return
            import re

            # تحويل PDF لصورة أو فتح الصورة مباشرة
            if fp.lower().endswith(".pdf"):
                try:
                    import fitz  # PyMuPDF
                    doc = fitz.open(fp)
                    page = doc[0]
                    mat = fitz.Matrix(2, 2)
                    pix = page.get_pixmap(matrix=mat)
                    img = Image.frombytes("RGB", [pix.width, pix.height], pix.samples)
                except ImportError:
                    messagebox.showwarning(t["warn_title"],
                        "لقراءة PDF تحتاج تثبيت PyMuPDF:\npip install pymupdf")
                    return
            else:
                img = Image.open(fp)

            # رفع دقة الصورة لتحسين OCR
            img = img.resize((img.width*2, img.height*2), Image.LANCZOS)
            # استخراج النص إنجليزي أولاً (أدق)
            text = pytesseract.image_to_string(img, lang="eng",
                config="--psm 6 --oem 3")
            # لو ما لقى بيانات — جرب بدون config
            if len(text.strip()) < 10:
                text = pytesseract.image_to_string(img, lang="ara+eng")

            # البحث عن البيانات في النص
            inv_num = ""
            qty     = ""
            price   = ""

            # ═══ رقم الفاتورة ═══
            # OCR أحياناً يدمج الكلمات — نصلح بالمنطق
            # ابحث عن pattern واضح أولاً
            inv_num = ""
            # ١. ابحث عن INV-XXX-NNNN بالضبط
            m = re.search(r"INV[-\s]?([A-Z]{2,4})[-\s]?(\d{3,})", text, re.IGNORECASE)
            if m:
                inv_num = f"INV-{m.group(1).upper()}-{m.group(2)}"
            # ٢. ابحث بعد Invoice:
            if not inv_num:
                m = re.search(r"Invoice[:\s]+([A-Z0-9\-]+)", text, re.IGNORECASE)
                if m:
                    raw = m.group(1).strip()
                    # صلح التلاصق: INVNATOTET → INV-NAT-0151
                    raw = re.sub(r"INV([A-Z]{2,4})(\d+)", r"INV--", raw, flags=re.IGNORECASE)
                    inv_num = raw
            # ٣. ابحث عن رقم الفاتورة عربي
            if not inv_num:
                m = re.search(r"رقم\s*الفاتورة[:\s]*(\S+)", text)
                if m:
                    inv_num = m.group(1).strip()

            # ═══ السعر ═══
            price = ""
            price_patterns = [
                r"Price[:\s]+(\d[\d,\.]+)",
                r"Unit\s*Price[:\s]*([\d,\.]+)",
                r"السعر\s*الوحدوي[:\s]*([\d,\.]+)",
                r"سعر\s*الوحدة[:\s]*([\d,\.]+)",
            ]
            for pattern in price_patterns:
                m = re.search(pattern, text, re.IGNORECASE)
                if m:
                    grp = m.group(1).strip().replace(",", "")
                    try:
                        if float(grp) > 100:
                            price = grp
                            break
                    except Exception:
                        pass

            # ═══ الكمية ═══
            qty_patterns = [
                r"(?:Qty|Quantity|الكمية|عدد)[.:\s]*(\d+)",
                r"(\d+)\s*(?:units?|pieces?|pcs|قطعة|وحدة)",
            ]
            for pattern in qty_patterns:
                m = re.search(pattern, text, re.IGNORECASE)
                if m:
                    qty = m.group(1)
                    break

            # ملأ الحقول
            if inv_num:
                self.inv_number.set(inv_num)
            if qty:
                self.inv_qty.set(qty)
            if price:
                self.inv_price.set(price)

            # حفظ مسار الملف
            self._inv_file_path = fp
            self.inv_file_label.config(text=os.path.basename(fp), fg=COLORS["accent2"])

            # رسالة نتيجة
            found = []
            if inv_num: found.append("رقم الفاتورة: " + inv_num)
            if qty:     found.append("الكمية: " + qty)
            if price:   found.append("السعر: " + price)

            if found:
                messagebox.showinfo("✅ تم المسح",
                    "تم استخراج البيانات التالية:\n" + "\n".join(found) +
                    "\n\nراجعي البيانات قبل الحفظ.")
            else:
                messagebox.showwarning("⚠️ لم يُعثر على بيانات",
                    "لم يتمكن النظام من استخراج بيانات واضحة.\nأدخلي البيانات يدوياً أو جرّبي صورة أوضح.")

        except Exception as e:
            messagebox.showerror("خطأ في المسح", str(e))

