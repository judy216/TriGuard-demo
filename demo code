def do_three_way_match(po_id):
    """منطق المطابقة الثلاثية — يحدّث حالة أمر الشراء تلقائياً"""
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute("SELECT quantity, unit_price FROM purchase_orders WHERE po_id=?", (po_id,))
    po = cursor.fetchone()
    cursor.execute("SELECT received_qty FROM goods_receipt WHERE po_id=? ORDER BY gr_id DESC LIMIT 1", (po_id,))
    gr = cursor.fetchone()
    cursor.execute("SELECT invoiced_qty, invoiced_price FROM supplier_invoices WHERE po_id=? ORDER BY inv_id DESC LIMIT 1", (po_id,))
    inv = cursor.fetchone()

    if not po:
        conn.close(); return False, "❌ أمر الشراء غير موجود"
    if not gr:
        conn.close(); return False, "⚠️ لا يوجد سجل استلام لهذا الأمر"
    if not inv:
        conn.close(); return False, "⚠️ لا توجد فاتورة لهذا الأمر"

    issues = []
    po_qty, po_price = po
    gr_qty            = gr[0]
    inv_qty, inv_price = inv

    if po_qty != gr_qty:
        issues.append(f"❌ الكمية: أمر الشراء ({po_qty}) ≠ الاستلام ({gr_qty})")
    if po_qty != inv_qty:
        issues.append(f"❌ الكمية: أمر الشراء ({po_qty}) ≠ الفاتورة ({inv_qty})")
    if abs(po_price - inv_price) > 0.01:
        issues.append(f"❌ السعر: أمر الشراء ({po_price}) ≠ الفاتورة ({inv_price})")

    if issues:
        new_status = "on_hold"
        message    = "🔴 تم إيقاف الدفع — يوجد اختلاف يستوجب المراجعة:\n\n" + "\n".join(issues)
        success    = False
    else:
        new_status = "approved"
        inv_amount = inv_qty * inv_price
        vat_amount = inv_amount * 0.15
        total_with_vat = inv_amount + vat_amount
        _customs_m     = inv_amount * 0.05
        _vat_m         = (inv_amount + _customs_m) * 0.15
        _grand_m       = inv_amount + _customs_m + _vat_m
        message        = (
            f"🟢 تمت المطابقة بنجاح!\n\n"
            f"المبلغ الأساسي:     ريال {inv_amount:,.2f}\n"
            f"رسوم الجمارك (5%): ريال {_customs_m:,.2f}\n"
            f"ضريبة VAT (15%):   ريال {_vat_m:,.2f}\n"
            f"الإجمالي الكلي:     ريال {_grand_m:,.2f}"
        )
        success    = True

    # ── تحديث حالة أمر الشراء تلقائياً ──
    cursor.execute("UPDATE purchase_orders SET status=? WHERE po_id=?", (new_status, po_id))
    conn.commit()
    conn.close()
    return success, message

