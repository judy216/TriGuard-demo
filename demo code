    def _btn(self, parent, text, command, **kwargs):
        return tk.Button(parent, text=text, command=command,
                         bg=COLORS["accent"], fg="white",
                         font=self.font_button, relief="flat",
                         padx=16, pady=6, cursor="hand2",
                         activebackground=COLORS["accent2"],
                         activeforeground=COLORS["bg"])

    def _make_tree_in_frame(self, parent, columns, widths):
        """إنشاء جدول داخل parent مع frame داخلي"""
        frame = tk.Frame(parent, bg=COLORS["bg"])
        frame.pack(fill="both", expand=True, padx=16, pady=(2,14))
        return self._make_tree_in(frame, columns, widths)

    def _make_tree_in(self, parent, columns, widths):
        """إنشاء جدول داخل إطار محدد"""
        style = ttk.Style()
        style.configure("Custom.Treeview",
                        background="#ffffff", foreground="#000000",
                        fieldbackground="#ffffff", rowheight=30,
                        font=("Arial",10,"bold"))
        style.configure("Custom.Treeview.Heading",
                        background=COLORS["sidebar"], foreground="#ffffff",
                        font=("Arial", 9, "bold"), relief="flat")
        style.map("Custom.Treeview",
                  background=[("selected", COLORS["sidebar_a"])],
                  foreground=[("selected", "#ffffff")])

        tree = ttk.Treeview(parent, columns=columns, show="headings",
                            style="Custom.Treeview")
        for col, w in zip(columns, widths):
            tree.heading(col, text=col)
            tree.column(col, width=w, anchor="center")

        sb = ttk.Scrollbar(parent, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=sb.set)
        sb.pack(side="left", fill="y")
        tree.pack(fill="both", expand=True)
        return tree

    def _make_tree(self, parent, columns, widths):
        style = ttk.Style()
        style.configure("Custom.Treeview",
                        background="#ffffff", foreground="#000000",
                        fieldbackground=COLORS["surface"], rowheight=28,
                        font=("Arial",9,"bold"))
        style.configure("Custom.Treeview.Heading",
                        background=COLORS["accent"], foreground="white",
                        font=("Arial", 9, "bold"), relief="flat")
        style.map("Custom.Treeview", background=[("selected", COLORS["accent2"])])

        frame = tk.Frame(parent, bg=COLORS["bg"])
        frame.pack(fill="both", expand=True, padx=16, pady=(6,14))

        tree = ttk.Treeview(frame, columns=columns, show="headings",
                            style="Custom.Treeview")
        for col, w in zip(columns, widths):
            tree.heading(col, text=col)
            tree.column(col, width=w, anchor="center")

        tree.tag_configure("odd",  background="#252536")
        tree.tag_configure("even", background=COLORS["surface"])

        sb = ttk.Scrollbar(frame, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=sb.set)
        sb.pack(side="left", fill="y")
        tree.pack(fill="both", expand=True)
        return tree

    def _all_po_options(self):
        """قائمة كل أوامر الشراء"""
        return [f"{r[0]} | {r[1]} - {r[3]}" for r in fetch_all_pos()]

    def _filter_combo(self, combo):
        """بحث ذكي في الـ Combobox أثناء الكتابة"""
        typed = combo.get().strip().lower()
        all_opts = self._all_po_options()
        if not typed:
            combo["values"] = all_opts
        else:
            combo["values"] = [o for o in all_opts if typed in o.lower()]
        try:
            combo.event_generate("<Down>")  # فتح القائمة تلقائياً
        except Exception:
            pass

    def _refresh_po_combos(self):
        """تحديث القوائم المنسدلة في جميع التبويبات"""
        options = self._all_po_options()
        for combo_name in ("gr_po_combo","inv_po_combo","match_po_combo"):
            cb = getattr(self, combo_name, None)
            if cb:
                cb["values"] = options

