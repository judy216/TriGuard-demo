        # ملاحظة المعرف
        note = tk.Frame(form, bg="#fff8e1",
                        highlightbackground="#f9a825", highlightthickness=1)
        note.pack(fill="x", padx=8, pady=(0, 8))
        _note_txt = ("⚠  Employee ID is granted by System Admin only — contact admin before registration"
                      if _en_r else
                      "⚠  رقم المعرف الوظيفي يُمنح من إدارة النظام فقط — تواصل مع المسؤول قبل التسجيل")
        tk.Label(note, text=_note_txt,
                 font=("Arial",8,"bold"), fg="#e65100",
                 bg="#fff8e1", justify="right",
                 wraplength=520).pack(padx=10, pady=6)

        _eid = "Employee ID *"        if _en_r else "رقم المعرف الوظيفي *"
        _un  = "Username *"           if _en_r else "اسم المستخدم *"
        _pw  = "Password *"           if _en_r else "كلمة المرور *"
        _cpw = "Confirm Password *"   if _en_r else "تأكيد كلمة المرور *"
        make_row(form, [
            (_eid, "employee_id", ""),
            (_un,  "username",    ""),
        ])
        make_row(form, [
            (_pw,  "password",   "●"),
            (_cpw, "confirm_pw", "●"),
        ])

        # رسالة
        msg_var = tk.StringVar()
        tk.Label(card, textvariable=msg_var,
                 font=("Arial",9,"bold"), fg=COLORS["error"],
                 bg="#ffffff").pack(padx=24, pady=(0,4))

        def do_register():
            v = {k: var.get().strip() for k, var in reg_vars.items()}
            # تحقق من الحقول الإلزامية
            required = ["first_name","last_name","national_id","email","job_title","username","password","confirm_pw","employee_id"]
            missing  = [f for f in required if not v[f]]
            if missing:
                msg_var.set("⚠ Please fill all required fields (*)" if _en_r else "⚠ يرجى تعبئة جميع الحقول الإلزامية (*)")
                return
            # التحقق من صحة المعرف الوظيفي
            conn_chk = get_connection()
            cur_chk  = conn_chk.cursor()
            cur_chk.execute("SELECT username FROM users WHERE employee_id=?", (v["employee_id"],))
            used_by = cur_chk.fetchone()
            conn_chk.close()
            if used_by:
                msg_var.set("❌ Employee ID already in use" if _en_r else "❌ رقم المعرف الوظيفي مستخدم مسبقاً")
                return
            # تحقق بسيط من تنسيق المعرف
            if not v["employee_id"].upper().startswith("EMP-"):
                msg_var.set("❌ ID must start with EMP- e.g. EMP-00123" if _en_r else "❌ رقم المعرف يجب أن يبدأ بـ EMP- مثال: EMP-0010")
                return
            if v["password"] != v["confirm_pw"]:
                msg_var.set("❌ Passwords do not match" if _en_r else "❌ كلمة المرور وتأكيدها غير متطابقتين")
                return
            if len(v["password"]) < 6:
                msg_var.set("⚠ Password must be at least 6 characters" if _en_r else "⚠ كلمة المرور يجب أن تكون 6 أحرف على الأقل")
                return

            full_name = f"{v['first_name']} {v['last_name']}"
            hashed    = hashlib.sha256(v["password"].encode()).hexdigest()
            created   = datetime.now().strftime("%Y-%m-%d %H:%M")
            # تحديد الدور من رقم المعرف: EMP-001xx=admin, EMP-003xx=viewer, غيره=user
            _eid = v["employee_id"].upper()
            # الدور يُحدد من المسمى الوظيفي المختار
            _job = v["job_title"].strip()
            if _job in ("مدير النظام", "System Admin"):
                auto_role = "admin"
            elif _job in ("مراقب", "Viewer"):
                auto_role = "viewer"
            else:
                auto_role = "user"
            try:
                conn = get_connection()
                cur  = conn.cursor()
                cur.execute("""
                    INSERT INTO users
                    (username,password,role,full_name,first_name,last_name,
                     national_id,email,phone,job_title,created_at,employee_id)
                    VALUES (?,?,?,?,?,?,?,?,?,?,?,?)
                """, (v["username"], hashed, auto_role, full_name,
                      v["first_name"], v["last_name"],                       v["national_id"], v["email"], v["phone"],
                      v["job_title"], created, _eid))
                conn.commit()
                conn.close()
                log_action(v["username"], "تسجيل حساب جديد", f"الاسم: {full_name}")
                messagebox.showinfo("تم التسجيل",
                    f"تم إنشاء حسابك بنجاح!\n\nاسم المستخدم: {v['username']}\n\n"
                    "يمكنك الآن تسجيل الدخول.", parent=win)
                win.destroy()
            except Exception as e:
                if "UNIQUE" in str(e):
                    msg_var.set("❌ اسم المستخدم مستخدم مسبقاً، اختر اسماً آخر")
                else:
                    msg_var.set(f"خطأ: {e}")

        # ── أزرار ──
        btn_frame = tk.Frame(card, bg="#ffffff")
        btn_frame.pack(padx=24, pady=(4,20), fill="x")
        tk.Button(btn_frame, text="إنشاء الحساب",
                  command=do_register,
                  bg=COLORS["sidebar_a"], fg="white",
                  font=("Arial",11,"bold"), relief="flat",
                  pady=10, cursor="hand2",
                  activebackground=COLORS["accent2"]).pack(side="right", fill="x", expand=True, padx=(8,0))
        tk.Button(btn_frame, text="إلغاء",
                  command=win.destroy,
                  bg=COLORS["border"], fg=COLORS["text"],
                  font=("Arial",10,"bold"), relief="flat",
                  pady=10, cursor="hand2").pack(side="right", padx=(0,8))


class ThreeWayMatchApp:
