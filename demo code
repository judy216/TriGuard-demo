        _lang     = getattr(self, "_current_lang", "ar")
        _tr       = TR.get(_lang, TR["ar"])
        nav_order = ["dash","po","gr","inv","match","reports","finance","audit"]
        nav_items = [(_tr[k][0], _tr[k][1], k) for k in nav_order]

        nav_frame = tk.Frame(sidebar, bg=COLORS["sidebar"])
        nav_frame.pack(fill="both", expand=True, pady=4)

        for icon, label, key in nav_items:
            row = tk.Frame(nav_frame, bg=COLORS["sidebar"], cursor="hand2")
            row.pack(fill="x", padx=6, pady=1)

            indicator = tk.Frame(row, bg="#ffffff", width=4)
            indicator.pack(side="right", fill="y")

            btn = tk.Button(row,
                            text=f"  {label}",
                            font=("Arial",9,"bold"), fg="#000000",
                            bg="#ffffff",
                            relief="flat", anchor="e",
                            padx=8, pady=5,
                            cursor="hand2",
                            activebackground=COLORS["sidebar_a"],
                            activeforeground="#ffffff",
                            command=lambda k=key, ind=indicator, r=row: self._show_page(k))
            btn.pack(fill="x", side="right", expand=True)

            def _enter(e, b=btn, r=row):
                if self._active_page != key:
                    b.configure(bg=COLORS["sidebar_a"], fg="#ffffff")
                    r.configure(bg=COLORS["sidebar_a"])

            def _leave(e, b=btn, r=row, k=key):
                if self._active_page != k:
                    b.configure(bg="#ffffff", fg="#000000")
                    r.configure(bg="#ffffff")

            btn.bind("<Enter>", _enter)
            btn.bind("<Leave>", _leave)
            row.bind("<Button-1>", lambda e, k=key: self._show_page(k))
            self._sidebar_btns[key] = (btn, indicator, row)

        # فاصل + نسخة
        tk.Frame(sidebar, bg=COLORS["sidebar_h"], height=1).pack(fill="x", padx=12, pady=8)
        tk.Label(sidebar, text="v1.0  ©  2026",
