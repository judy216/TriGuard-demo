        """فتح ملف الفاتورة الأصلية في نافذة منفصلة"""
        t = TR.get(getattr(self,"_current_lang","ar"), TR["ar"])
        import os
        if not os.path.exists(filepath):
            messagebox.showerror(t["err_title"], f"الملف غير موجود:\n{filepath}")
            return

        ext = filepath.lower().split(".")[-1]

        if ext == "pdf":
            # فتح PDF بالبرنامج الافتراضي
            try:
                if os.name == "nt":
                    os.startfile(filepath)
                else:
                    import subprocess
                    subprocess.Popen(["xdg-open", filepath])
            except Exception as e:
                messagebox.showerror(t["err_title"], str(e))

        elif ext in ("png", "jpg", "jpeg", "bmp", "tiff"):
