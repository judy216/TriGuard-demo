def create_database():
    """إنشاء قاعدة البيانات والجداول إذا لم تكن موجودة"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()

    # جدول أوامر الشراء
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS purchase_orders (
            po_id           INTEGER PRIMARY KEY AUTOINCREMENT,
            po_number       TEXT UNIQUE NOT NULL,
            supplier        TEXT NOT NULL,
            item_name       TEXT NOT NULL,
            quantity        INTEGER NOT NULL,
            unit_price      REAL NOT NULL,
            po_date         TEXT NOT NULL,
            status          TEXT DEFAULT 'pending',
            customs_pct     REAL DEFAULT 5.0,
            vat_pct         REAL DEFAULT 15.0
        )
    """)
    for col in ["customs_pct REAL DEFAULT 5.0", "vat_pct REAL DEFAULT 15.0"]:
        try:
            cursor.execute(f"ALTER TABLE purchase_orders ADD COLUMN {col}")
        except Exception:
            pass

    # جدول الاستلام
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS goods_receipt (
            gr_id         INTEGER PRIMARY KEY AUTOINCREMENT,
            po_id         INTEGER NOT NULL,
            received_qty  INTEGER NOT NULL,
            received_date TEXT NOT NULL,
            FOREIGN KEY (po_id) REFERENCES purchase_orders(po_id)
        )
    """)

    # جدول الفواتير
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS supplier_invoices (
            inv_id         INTEGER PRIMARY KEY AUTOINCREMENT,
            po_id          INTEGER NOT NULL,
            invoice_number TEXT NOT NULL,
            invoiced_qty   INTEGER NOT NULL,
            invoiced_price REAL NOT NULL,
            invoice_date   TEXT NOT NULL,
            invoice_file   TEXT DEFAULT NULL,
            FOREIGN KEY (po_id) REFERENCES purchase_orders(po_id)
        )
    """)
    # إضافة العمود لو الجدول موجود من قبل بدون العمود
    try:
        cursor.execute("ALTER TABLE supplier_invoices ADD COLUMN invoice_file TEXT DEFAULT NULL")
    except Exception:
        pass

    # جدول نتائج المطابقة
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS matching_results (
            match_id     INTEGER PRIMARY KEY AUTOINCREMENT,
            po_id        INTEGER NOT NULL,
            match_status TEXT NOT NULL,
            notes        TEXT,
            checked_date TEXT NOT NULL,
            FOREIGN KEY (po_id) REFERENCES purchase_orders(po_id)
        )
    """)

