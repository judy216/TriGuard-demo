    def refresh_gr_table(self):
        """تحديث جدول الاستلام"""
        if not hasattr(self, "gr_tree"):
            return
        for row in self.gr_tree.get_children():
            self.gr_tree.delete(row)
        try:
            conn = get_connection()
            rows = conn.execute("""
                SELECT p.po_number, p.supplier, g.received_qty, g.receipt_date, g.gr_id
                FROM goods_receipts g
                JOIN purchase_orders p ON g.po_id = p.po_id
                ORDER BY g.gr_id DESC
            """).fetchall()
            conn.close()
            for r in rows:
                self.gr_tree.insert("", "end", iid=r[4], values=r[:4])
        except Exception as e:
            print(f"refresh_gr_table error: {e}")

    def refresh_inv_table(self):
        """تحديث جدول الفواتير مع دعم البحث"""
        if not hasattr(self, "inv_tree"):
            return
        q = ""
        if hasattr(self, "inv_search_var"):
            try:
                raw = self.inv_search_var.get()
                q = raw.strip().lower() if raw else ""
            except Exception:
                q = ""
        for row in self.inv_tree.get_children():
            self.inv_tree.delete(row)
        conn = get_connection()
        cur  = conn.cursor()
        if q:
            like = f"%{q}%"
            cur.execute("""
                SELECT p.po_number, p.supplier, i.invoice_number,
                       i.invoiced_qty, i.invoiced_price, i.invoice_date,
                       i.invoice_file, i.inv_id
                FROM supplier_invoices i
                JOIN purchase_orders p ON i.po_id = p.po_id
                WHERE LOWER(p.po_number)                    LIKE ?
                   OR LOWER(p.supplier)                     LIKE ?
                   OR LOWER(COALESCE(i.invoice_number,''))  LIKE ?
                   OR LOWER(COALESCE(p.item_name,''))       LIKE ?
                ORDER BY i.inv_id DESC
            """, (like, like, like, like))
        else:
            cur.execute("""
                SELECT p.po_number, p.supplier, i.invoice_number,
                       i.invoiced_qty, i.invoiced_price, i.invoice_date,
                       i.invoice_file, i.inv_id
                FROM supplier_invoices i
                JOIN purchase_orders p ON i.po_id = p.po_id
                ORDER BY i.inv_id DESC
            """)
        for row in cur.fetchall():
            has_file = "📎 نعم" if row[6] else "—"
            tag      = "has_file" if row[6] else "no_file"
            self.inv_tree.insert("", "end", iid=row[7],
                                 values=(row[0],row[1],row[2],row[3],
                                         f"{row[4]:,.2f}",row[5],has_file),
                                 tags=(tag,))
        self.inv_tree.tag_configure("has_file", foreground=COLORS["accent2"])
        self.inv_tree.tag_configure("no_file",  foreground="#000000")
        conn.close()

    def _on_inv_double_click(self, event):
        """كليك مزدوج على فاتورة — يفتح سجل المورد"""
        sel = self.inv_tree.selection()
        if not sel:
            return
        values = self.inv_tree.item(sel[0])["values"]
        if values and len(values) > 1:
            supplier = str(values[1])
            self._show_supplier_history(supplier)

    def _on_inv_select(self, event):
        """عند الكليك على فاتورة — افتح الفاتورة الأصلية + نافذة التفاصيل"""
        sel = self.inv_tree.selection()
        if not sel:
            return
        inv_id = int(sel[0])
        conn = get_connection()
        cur  = conn.cursor()
        cur.execute("SELECT invoice_file, po_id FROM supplier_invoices WHERE inv_id=?", (inv_id,))
        row = cur.fetchone()
        conn.close()
        if not row:
            return

