        self._clear_report_tree()
        _c1 = "Orders Count" if _en_sr else "عدد الأوامر"
        _c2 = "First Order"  if _en_sr else "أول أمر"
        _c3 = "Last Order"   if _en_sr else "آخر أمر"
        cols   = (t["col_supplier"], _c1, t["total_purchases"], _c2, _c3)
        widths = (180, 100, 130, 100, 100)
        tree   = self._make_tree_in(self.report_tree_frame, cols, widths)
        for row in report_by_supplier():
            display = list(row)
            display[2] = f"{row[2]:,.2f} ريال"
            tree.insert("", "end", values=display)
        # كليك على مورد يفتح سجله
        def _on_sup_click(event):
            sel = tree.selection()
            if not sel:
                return
            supplier_name = str(tree.item(sel[0])["values"][0])
            self._show_supplier_history(supplier_name)
        tree.bind("<<TreeviewSelect>>", _on_sup_click)
        self._current_tree = tree

    def _export_current_pdf(self):
        t = TR.get(getattr(self,"_current_lang","ar"), TR["ar"])
        if not self._current_report:
            messagebox.showwarning(t["warn_title"], "اختر تقريراً أولاً ثم صدّره")
            return
        if not REPORTLAB_OK:
            messagebox.showerror(t["lib_missing"],
                "ثبّت مكتبة reportlab أولاً عبر:\n\npip install reportlab")
            return

        file_path = filedialog.asksaveasfilename(
            defaultextension=".pdf",
            filetypes=[("PDF files", "*.pdf")],
            title="حفظ التقرير كـ PDF"
        )
        if not file_path:
            return

        if self._current_report == "match":
            title   = "Matching Results Report"
            headers = ["PO Number", "Supplier", "Item", "Status", "Notes", "Date"]
            rows    = [list(r) for r in report_matching_results()]
            for r in rows:
                r[3] = "Matched" if r[3] == "matched" else "❌ Mismatch"

        elif self._current_report == "unpaid":
            title   = "Unpaid Invoices Report"
            headers = ["PO#", "Supplier", "Item", "Invoice#", "Qty", "Price", "Total", "Date"]
            rows    = [list(r) for r in report_unpaid_invoices()]
            for r in rows:
                r[6] = f"{r[6]:,.2f}"

        else:
            title   = "Purchases by Supplier Report"
            headers = ["Supplier", "Orders", "Total Value", "First Order", "Last Order"]
            rows    = [list(r) for r in report_by_supplier()]
            for r in rows:
                r[2] = f"{r[2]:,.2f}"

        ok, msg = export_pdf(title, headers, rows, file_path)
        if ok:
            messagebox.showinfo(t["export_done"], f"تم حفظ التقرير في:\n{file_path}")
            os.startfile(file_path) if os.name == "nt" else None
        else:
            messagebox.showerror(t["err_title"], msg)

