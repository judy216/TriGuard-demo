    def _build_dashboard(self):
        t = TR.get(getattr(self,'_current_lang','ar'), TR['ar'])
        conn = get_connection()
        cur  = conn.cursor()
        cur.execute("SELECT COUNT(*) FROM purchase_orders")
        total_po = cur.fetchone()[0]
        cur.execute("SELECT COUNT(*) FROM purchase_orders WHERE status='approved'")
        approved = cur.fetchone()[0]
        cur.execute("SELECT COUNT(*) FROM purchase_orders WHERE status='on_hold'")
        on_hold  = cur.fetchone()[0]
        cur.execute("SELECT COUNT(*) FROM purchase_orders WHERE status='pending'")
        pending  = cur.fetchone()[0]
        cur.execute("SELECT COALESCE(SUM(quantity*unit_price),0) FROM purchase_orders")
        total_val = cur.fetchone()[0]
        cur.execute("SELECT COALESCE(SUM(quantity*unit_price),0) FROM purchase_orders WHERE status='approved'")
        approved_val = cur.fetchone()[0]
        cur.execute("""SELECT p.po_number, p.supplier, m.match_status, m.checked_date
                       FROM matching_results m JOIN purchase_orders p ON m.po_id=p.po_id
                       ORDER BY m.match_id DESC LIMIT 5""")
        recent = cur.fetchall()
        conn.close()

        # ── شريط ترحيب ──
        page_hdr = tk.Frame(self.tab_dash, bg="#ffffff",
                            highlightbackground=COLORS["border"],
                            highlightthickness=1)
