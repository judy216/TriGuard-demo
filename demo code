    def _build_pages(self):
        """بناء جميع الصفحات وإخفاؤها"""
        page_builders = {
            "dash":    self._build_dashboard,
            "po":      self._build_po_tab,
            "gr":      self._build_gr_tab,
            "inv":     self._build_inv_tab,
            "match":   self._build_match_tab,
            "reports": self._build_reports_tab,
            "finance": self._build_finance_tab,
            "audit":   self._build_audit_tab,
        }
        # مراجعة التبويبات القديمة
        self.tab_dash    = tk.Frame(self.content_area, bg=COLORS["bg"])
        self.tab_po      = tk.Frame(self.content_area, bg=COLORS["bg"])
        self.tab_gr      = tk.Frame(self.content_area, bg=COLORS["bg"])
        self.tab_inv     = tk.Frame(self.content_area, bg=COLORS["bg"])
        self.tab_match   = tk.Frame(self.content_area, bg=COLORS["bg"])
        self.tab_reports = tk.Frame(self.content_area, bg=COLORS["bg"])
        self.tab_finance = tk.Frame(self.content_area, bg=COLORS["bg"])
        self.tab_audit   = tk.Frame(self.content_area, bg=COLORS["bg"])

        self._pages = {
            "dash":    self.tab_dash,
            "po":      self.tab_po,
            "gr":      self.tab_gr,
            "inv":     self.tab_inv,
            "match":   self.tab_match,
            "reports": self.tab_reports,
            "finance": self.tab_finance,
            "audit":   self.tab_audit,
        }
        for key, frame in self._pages.items():
            frame.place(relwidth=1, relheight=1)
            frame.lower()

        # بناء المحتوى
        for key, builder in page_builders.items():
            try:
                builder()
            except Exception as _e:
                import traceback
                print(f"ERROR building page '{key}': {_e}")
                traceback.print_exc()

    def _show_page(self, key):
        """إظهار صفحة وإخفاء الباقي — مع تأثير Sidebar"""
        for k, frame in self._pages.items():
            frame.lower()
        self._pages[key].lift()
        self._active_page = key

        for k, (btn, ind, row) in self._sidebar_btns.items():
            if k == key:
                btn.configure(bg=COLORS["sidebar_a"], fg="#ffffff",
                              font=("Arial",10,"bold"))
                row.configure(bg=COLORS["sidebar_a"])
                ind.configure(bg=COLORS["sidebar_a"])
            else:
                btn.configure(bg="#ffffff", fg="#000000",
                              font=("Arial",10,"bold"))
                row.configure(bg="#ffffff")
                ind.configure(bg="#ffffff")


