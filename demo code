    cursor = conn.cursor()
    cursor.execute("""
        SELECT p.po_number, p.supplier, p.item_name,
               i.invoice_number, i.invoiced_qty, i.invoiced_price,
               (i.invoiced_qty * i.invoiced_price) AS total,
               i.invoice_date
        FROM supplier_invoices i
        JOIN purchase_orders p ON i.po_id = p.po_id
        WHERE p.po_id NOT IN (
            SELECT po_id FROM matching_results WHERE match_status='matched'
        )
        ORDER BY i.invoice_date DESC
    """)
    rows = cursor.fetchall()
    conn.close()
    return rows

def report_by_supplier():
    """تقرير المشتريات حسب المورد"""
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT supplier,
               COUNT(*) AS عدد_الأوامر,
               SUM(quantity * unit_price) AS إجمالي_القيمة,
               MIN(po_date) AS أول_أمر,
               MAX(po_date) AS آخر_أمر
        FROM purchase_orders
        GROUP BY supplier
        ORDER BY إجمالي_القيمة DESC
    """)
    rows = cursor.fetchall()
    conn.close()
    return rows

def export_pdf(title, headers, rows, filename):
    """تصدير التقرير كملف PDF"""
    if not REPORTLAB_OK:
        return False, "يرجى تثبيت مكتبة reportlab:\npip install reportlab"

    doc = SimpleDocTemplate(filename, pagesize=A4,
                            rightMargin=30, leftMargin=30,
                            topMargin=30, bottomMargin=30)
    story = []
    styles = getSampleStyleSheet()

    # عنوان التقرير
    title_style = ParagraphStyle("title", fontSize=16, alignment=TA_CENTER,
                                 spaceAfter=6, textColor=rl_colors.HexColor("#7c6af7"),
                                 fontName="Helvetica-Bold")
    story.append(Paragraph(title, title_style))

    date_style = ParagraphStyle("date", fontSize=9, alignment=TA_CENTER,
                                spaceAfter=16, textColor=rl_colors.grey)
    story.append(Paragraph(f"Report Date: {date.today()}", date_style))
    story.append(Spacer(1, 8))

    # بناء الجدول
    table_data = [headers] + [list(r) for r in rows]
    if len(rows) == 0:
        table_data.append(["No data available"] + [""] * (len(headers) - 1))

    col_count = len(headers)
    col_width = (A4[0] - 60) / col_count

    tbl = Table(table_data, colWidths=[col_width] * col_count, repeatRows=1)
    tbl.setStyle(TableStyle([
        ("BACKGROUND",   (0, 0), (-1, 0),  rl_colors.HexColor("#7c6af7")),
        ("TEXTCOLOR",    (0, 0), (-1, 0),  rl_colors.white),
        ("FONTNAME",     (0, 0), (-1, 0),  "Helvetica-Bold"),
        ("FONTSIZE",     (0, 0), (-1, 0),  10),
        ("ALIGN",        (0, 0), (-1, -1), "CENTER"),
        ("VALIGN",       (0, 0), (-1, -1), "MIDDLE"),
        ("ROWBACKGROUNDS", (0, 1), (-1, -1), [rl_colors.HexColor("#f0eeff"), rl_colors.white]),
        ("GRID",         (0, 0), (-1, -1), 0.5, rl_colors.HexColor("#cccccc")),
        ("FONTSIZE",     (0, 1), (-1, -1), 8),
        ("ROWHEIGHT",    (0, 0), (-1, -1), 22),
    ]))
    story.append(tbl)
    doc.build(story)
    return True, filename

