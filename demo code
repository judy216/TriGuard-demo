    def _login(self):
        username = self.username_var.get().strip()
        password = self.password_var.get().strip()
        if not username or not password:
            self.msg_var.set("⚠  أدخل اسم المستخدم وكلمة المرور")
            return
        hashed = hashlib.sha256(password.encode()).hexdigest()
        conn = get_connection()
        cur  = conn.cursor()
        cur.execute("SELECT role, full_name FROM users WHERE username=? AND password=?",
                    (username, hashed))
        row = cur.fetchone()
        conn.close()
        if row:
            _role_map = {"admin":"مدير النظام","user":"موظف المشتريات","viewer":"مراقب"}
            _role_ar = _role_map.get(row[0], row[0])
            save_login(username, password)
            log_action(username, "تسجيل دخول", f"الدور: {_role_ar}")
            self.on_success(username, row[0], row[1])
        else:
            self.msg_var.set("❌  اسم المستخدم أو كلمة المرور غير صحيحة")
            log_action(username, "محاولة دخول فاشلة")

