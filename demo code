        search = getattr(self, "po_search_var", None)
        search = search.get().strip().lower() if search else ""
        filt   = getattr(self, "po_filter_var", None)
        filt   = filt.get() if filt else t["all"]
        for r in fetch_all_pos():
            raw_status   = r[7] if len(r) > 7 else "pending"
            status_label = STATUS_LABELS.get(raw_status, raw_status)
            # تصفية الحالة
            if filt != t["all"] and status_label != filt:
                continue
            # بحث نصي
            if search and search not in " ".join(str(v) for v in r).lower():
                continue
            display = list(r[1:7]) + [status_label]
            tag = raw_status if raw_status in ("approved","on_hold","pending") else "pending"
            self.po_tree.insert("", "end", iid=r[0], values=display, tags=(tag,))

