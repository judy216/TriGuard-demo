    def _read_csv(self, filepath):
        """قراءة ملف CSV وإرجاع الصفوف"""
        import csv
        rows = []
        with open(filepath, encoding="utf-8-sig", newline="") as f:
            reader = csv.DictReader(f)
            for r in reader:
                rows.append(r)
        return rows

    def _read_excel(self, filepath):
        """قراءة ملف Excel — يجرب openpyxl ثم xlrd ثم pandas"""
        # المحاولة 1: openpyxl (للـ .xlsx)
        try:
            import openpyxl
            wb       = openpyxl.load_workbook(filepath, read_only=True, data_only=True)
            ws       = wb.active
            rows_raw = list(ws.iter_rows(values_only=True))
            wb.close()
            if not rows_raw:
                return []
            headers = [str(h).strip() if h not in (None,"") else f"col{i}"
                       for i, h in enumerate(rows_raw[0])]
            result  = []
            for r in rows_raw[1:]:
                if any(v not in (None,"") for v in r):
                    result.append({
                        headers[i]: (str(v).strip() if v not in (None,"") else "")
                        for i, v in enumerate(r)
                    })
            return result
        except ImportError:
            pass
        except Exception as e:
            messagebox.showerror("خطأ openpyxl", str(e))
            return []

        # المحاولة 2: pandas
        try:
            import pandas as pd
            df = pd.read_excel(filepath)
            return df.fillna("").astype(str).to_dict("records")
        except ImportError:
            pass
        except Exception as e:
            messagebox.showerror("خطأ pandas", str(e))
            return []

        # لو كل المحاولات فشلت
        messagebox.showerror(
            t["lib_missing"],
            "لقراءة Excel ثبّتي إحدى المكتبات:\n\n"
            "  python -m pip install openpyxl\n"
            "أو:\n"
            "  python -m pip install pandas openpyxl\n\n"
            "ملاحظة: ملفات CSV تعمل بدون أي مكتبة إضافية!"
        )
        return []

