    def _run_match_all(self):
        """مطابقة جميع الأوامر دفعة واحدة"""
        t = TR.get(getattr(self,"_current_lang","ar"), TR["ar"])
        rows = fetch_all_pos()
        matched = mismatch = skipped = 0
        for r in rows:
            po_id = r[0]
            success, message = do_three_way_match(po_id)
            if "لا يوجد" in message or "غير موجود" in message:
                skipped += 1
                continue
            conn = get_connection()
            conn.execute(
                "INSERT INTO matching_results (po_id,match_status,notes,checked_date) VALUES (?,?,?,?)",
                (po_id, "matched" if success else "mismatch", message, str(date.today()))
            )
            conn.commit()
            conn.close()
            if success:
                matched += 1
            else:
                mismatch += 1
        self.refresh_po_table()
        self.refresh_match_table()
        _en_mall = getattr(self,"_current_lang","ar")=="en"
        if _en_mall:
            _mall_msg = (f"Auto-matching complete:\n\n"
                         f"✅ Matched: {matched}\n"
                         f"❌ Mismatch: {mismatch}\n"
                         f"⏭️ Skipped (incomplete data): {skipped}")
        else:
            _mall_msg = (f"اكتملت المطابقة التلقائية:\n\n"
                         f"✅ ناجحة: {matched}\n"
                         f"❌ فيها اختلاف: {mismatch}\n"
                         f"⏭️ تجاوزت (بيانات ناقصة): {skipped}")
        messagebox.showinfo(t["match_all_done"], _mall_msg)

    def refresh_match_table(self):
        t = TR.get(getattr(self,"_current_lang","ar"), TR["ar"])
        """تحديث جدول نتائج المطابقة"""
        for row in self.match_tree.get_children():
            self.match_tree.delete(row)
        conn = get_connection()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT p.po_number, p.supplier, p.item_name,
                   m.match_status, m.notes, m.checked_date
            FROM matching_results m
            JOIN purchase_orders p ON m.po_id = p.po_id
            ORDER BY m.match_id DESC
        """)
        for row in cursor.fetchall():
            status_raw = row[3]
            display = list(row)
            display[3] = t["success"] if status_raw == "matched" else ("🔴 " + ("On Hold" if getattr(self,"_current_lang","ar")=="en" else "موقوف"))
            self.match_tree.insert("", "end", values=display, tags=(status_raw,))
        conn.close()

    def _on_match_select(self, event):
        sel = self.match_tree.selection()
        if not sel:
            return
        values = self.match_tree.item(sel[0], "values")
        if not values:
            return
        # البحث عن po_id من رقم الأمر
        po_number = values[0]
        conn = get_connection()
        cur  = conn.cursor()
        cur.execute("SELECT po_id FROM purchase_orders WHERE po_number=?", (po_number,))
        row = cur.fetchone()
        conn.close()
        if row:
            self._show_po_details(row[0])

