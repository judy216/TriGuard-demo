        self.root.resizable(True, True)
        self.root.minsize(900, 600)

        _f = MAIN_FONT  # الخط الرئيسي — أبشر style
        self.font_title  = (_f, 15, "bold")
        self.font_label  = (_f, 10, "bold")
        self.font_button = (_f, 10, "bold")
