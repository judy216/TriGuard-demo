MAIN_FONT = "Arial"  # سيتم تحديثه لو وُجد خط عربي

def setup_fonts():
    """إعداد الخطوط — يُستدعى بعد إنشاء نافذة tk"""
    global MAIN_FONT
    try:
        import tkinter.font as tkfont
        available = tkfont.families()
        # ابحث عن أفضل خط عربي متاح على الجهاز
        arabic_priority = [
            "IBM Plex Sans Arabic",
            "Noto Kufi Arabic", 
            "Noto Sans Arabic",
            "Cairo",
            "Tajawal",
            "Amiri",
            "Scheherazade New",
            "Traditional Arabic",
            "Simplified Arabic",
            "Arabic Typesetting",
        ]
        for font_name in arabic_priority:
            if font_name in available:
                MAIN_FONT = font_name
                print(f"✅ خط أبشر: {font_name}")
                return font_name
        print(f"⚠️ خط عربي متخصص غير موجود، يستخدم: Arial")
        return "Arial"
    except Exception:
        return "Arial"

