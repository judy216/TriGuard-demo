    def _import_po_csv(self):
        """استيراد أوامر الشراء من CSV"""
        import csv as _csv
        _t = TR.get(getattr(self,"_current_lang","ar"), TR["ar"])
        fp = filedialog.askopenfilename(
            title="اختر ملف أوامر الشراء CSV",
            filetypes=[("CSV", "*.csv"), ("All", "*.*")]
        )
        if not fp:
            return
        ok = skip = err = 0
        try:
            with open(fp, encoding="utf-8-sig", newline="") as f:
                reader = _csv.DictReader(f)
                for r in reader:
                    try:
                        po_num   = (r.get("po_number") or r.get("رقم الأمر") or "").strip()
                        supplier = (r.get("supplier")  or r.get("المورد")    or "").strip()
                        item     = (r.get("item_name") or r.get("الصنف")     or "").strip()
                        qty      = r.get("quantity")   or r.get("الكمية")    or "0"
                        price    = r.get("unit_price") or r.get("السعر")     or "0"
                        date     = (r.get("po_date")   or r.get("التاريخ")   or "").strip()
                        if not (po_num and supplier and item):
                            skip += 1
                            continue
                        add_purchase_order(po_num, supplier, item,
                                           int(float(str(qty).replace(",",""))),
                                           float(str(price).replace(",","")), date)
                        ok += 1
                    except Exception as _ex:
                        err += 1
            self.refresh_po_table()
            self._refresh_po_combos()
            messagebox.showinfo(_t["done"],
                "تم استيراد " + str(ok) + " امر\nتجاوز: " + str(skip) + "\nاخطاء: " + str(err))
        except Exception as e:
            messagebox.showerror("خطأ في الاستيراد", str(e))

    def _add_po(self):
        t = TR.get(getattr(self,"_current_lang","ar"), TR["ar"])
        v = self.po_vars
        try:
            po_num = self.po_number_var.get()
            add_purchase_order(
                po_num, v["supplier"].get(),
                v["item_name"].get(), v["quantity"].get(),
                v["unit_price"].get(), v["po_date"].get()
            )
            messagebox.showinfo(t["done"], f"تمت إضافة أمر الشراء بنجاح!\nرقم الأمر: {po_num}")
            self.po_number_var.set(generate_po_number())
            self.refresh_po_table()
            self._refresh_po_combos()
        except Exception as e:
            messagebox.showerror(t["err_title"], f"تأكد من إدخال جميع البيانات بشكل صحيح\n{e}")

