    def _build_users_tab(self, tab, t, win):
        """تبويب إدارة المستخدمين — حذف الحسابات"""
        BG = COLORS["bg"]

        # عنوان
        hdr = tk.Frame(tab, bg=COLORS["sidebar"])
        hdr.pack(fill="x")
        tk.Label(hdr, text=t["del_user_title"],
                 font=("Arial",12,"bold"), fg="#ffffff",
                 bg=COLORS["sidebar"]).pack(side="right", padx=16, pady=10)

        # جلب المستخدمين
        def load_users():
            conn = get_connection()
            cur  = conn.cursor()
            cur.execute("""SELECT username, full_name, role, created_at
                           FROM users ORDER BY user_id""")
            rows = cur.fetchall()
            conn.close()
            return rows

        def refresh_tree():
            for r in tree.get_children():
                tree.delete(r)
            ROLE_LABELS = {"admin": t["admin_role"], "user": t["user_role"], "viewer": t["viewer_role"]}
            for row in load_users():
                role_lbl = ROLE_LABELS.get(row[2], row[2])
                tag = "admin_row" if row[2] == "admin" else "normal_row"
                tree.insert("", "end", values=(row[0], row[1] or "—", role_lbl, row[3] or "—"), tags=(tag,))

        # جدول المستخدمين
        frm = tk.Frame(tab, bg=BG)
        frm.pack(fill="both", expand=True, padx=14, pady=10)

        style = ttk.Style()
        style.configure("Users.Treeview",
                         background="#ffffff", foreground="#000000",
                         fieldbackground="#ffffff", rowheight=30,
                         font=("Arial",10,"bold"))
        style.configure("Users.Treeview.Heading",
                         background=COLORS["sidebar"], foreground="#ffffff",
                         font=("Arial",9,"bold"), relief="flat")
        style.map("Users.Treeview",
                  background=[("selected", COLORS["sidebar_a"])],
                  foreground=[("selected","#ffffff")])

        cols   = (t["col_username"], t["col_fullname"], t["col_role"], t["col_created"])
        widths = (120, 160, 100, 120)
        tree = ttk.Treeview(frm, columns=cols, show="headings", style="Users.Treeview", height=8)
        for col, w in zip(cols, widths):
            tree.heading(col, text=col)
            tree.column(col, width=w, anchor="center")
        tree.tag_configure("admin_row", foreground=COLORS["accent"])
        tree.tag_configure("normal_row", foreground="#000000")

        sb = ttk.Scrollbar(frm, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=sb.set)
        sb.pack(side="left", fill="y")
        tree.pack(fill="both", expand=True)

        refresh_tree()

        # تلميح
        tk.Label(tab, text=t["del_user_hint"],
                 font=("Arial",9,"bold"), fg="#000000",
                 bg=BG).pack(pady=(4,2))

        # رسالة
        msg_var = tk.StringVar()
        tk.Label(tab, textvariable=msg_var,
                 font=("Arial",9,"bold"), fg=COLORS["error"],
                 bg=BG).pack(pady=(0,4))

        # زر الحذف
        def delete_user():
            sel = tree.selection()
            if not sel:
                msg_var.set("⚠ اختر مستخدماً أولاً")
                return
            username = tree.item(sel[0])["values"][0]
            # منع حذف المدير الحالي
            if username == self.username:
                msg_var.set(t["del_warn"])
                return
            # منع حذف آخر مدير
            conn_c = get_connection()
            cur_c  = conn_c.cursor()
            cur_c.execute("SELECT COUNT(*) FROM users WHERE role='admin'")
            admin_count = cur_c.fetchone()[0]
            cur_c.execute("SELECT role FROM users WHERE username=?", (username,))
            target_role = cur_c.fetchone()
            conn_c.close()
            if target_role and target_role[0]=="admin" and admin_count <= 1:
                msg_var.set("⚠ لا يمكن حذف المدير الوحيد في النظام")
                return

            _del_q = t["del_confirm"]
            _del_body = t["del_msg"] + " (" + str(username) + ")\n\nهذا الإجراء لا يمكن التراجع عنه."
            if not messagebox.askyesno(_del_q, _del_body, parent=win):
                return



            conn_d = get_connection()
            conn_d.execute("DELETE FROM users WHERE username=?", (username,))
            conn_d.commit()
            conn_d.close()
            log_action(self.username, "حذف مستخدم", f"المحذوف: {username}")
            msg_var.set(f"✅ {t['del_done']}: {username}")
            refresh_tree()

        del_btn = tk.Button(tab, text=t["del_btn"],
                            command=delete_user,
                            bg=COLORS["error"], fg="white",
                            font=("Arial",11,"bold"), relief="flat",
                            pady=10, cursor="hand2",
                            activebackground="#8b0000")
        del_btn.pack(padx=24, pady=(0,10), fill="x")

    def _auto_save(self):
        """حفظ تلقائي — يستدعي نفسه كل 5 دقائق"""
        try:
