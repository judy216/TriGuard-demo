    def _export_finance_excel(self, sheet_type):
        t = TR.get(getattr(self,"_current_lang","ar"), TR["ar"])
        """تصدير القوائم المالية إلى Excel"""
        t = TR.get(getattr(self,"_current_lang","ar"), TR["ar"])
        try:
            import openpyxl
            from openpyxl.styles import Font, PatternFill, Alignment, Border, Side, numbers
        except ImportError:
            messagebox.showerror(t["lib_missing"],
                "ثبّتي openpyxl:\n\n  python -m pip install openpyxl")
            return

        fp = filedialog.asksaveasfilename(
            defaultextension=".xlsx",
            filetypes=[("Excel","*.xlsx")],
            initialfile={
                "bs":  "قائمة_المركز_المالي.xlsx",
                "is":  "قائمة_الدخل.xlsx",
                "jnl": "القيود_المحاسبية.xlsx",
            }.get(sheet_type, "القوائم_المالية.xlsx")
        )
        if not fp:
            return

        # جلب البيانات من قاعدة البيانات
        conn = get_connection()
        cur  = conn.cursor()
        cur.execute("SELECT COALESCE(SUM(amount_dr),0) FROM journal_entries WHERE account_dr='المخزون / بضاعة'")
        inventory = cur.fetchone()[0]
        cur.execute("SELECT COALESCE(SUM(amount_cr),0) FROM journal_entries WHERE account_cr='الذمم الدائنة (موردون)'")
        payables = cur.fetchone()[0]
        cur.execute("SELECT COALESCE(SUM(amount_cr),0) FROM journal_entries WHERE account_cr='النقدية / البنك'")
        cash_out = cur.fetchone()[0]
        cur.execute("SELECT COALESCE(SUM(amount_dr),0) FROM journal_entries WHERE account_dr='مصروف المشتريات'")
        purchases = cur.fetchone()[0]
        cur.execute("SELECT entry_date,description,account_dr,amount_dr,account_cr,amount_cr,entry_type FROM journal_entries ORDER BY entry_id DESC")
        journal_rows = cur.fetchall()
        conn.close()

        equity_capital = 12000000.0
        cash_balance   = max(equity_capital - cash_out, 0)
        total_assets   = cash_balance + inventory
        total_liab     = payables
        equity         = total_assets - total_liab
        revenue        = purchases * 1.20
        gross_profit   = revenue - purchases
        other_exp      = revenue * 0.05
        net_income     = gross_profit - other_exp

        wb = openpyxl.Workbook()

        # ── ألوان وأنماط ──
        hdr_fill  = PatternFill("solid", fgColor="0D1B2A")
        sec_fill  = PatternFill("solid", fgColor="1565C0")
        row_fill1 = PatternFill("solid", fgColor="EBF0FA")
        row_fill2 = PatternFill("solid", fgColor="FFFFFF")
        tot_fill  = PatternFill("solid", fgColor="DCE4F0")
        thin      = Border(
            left=Side(style="thin", color="C0CCDD"),
            right=Side(style="thin", color="C0CCDD"),
            top=Side(style="thin", color="C0CCDD"),
            bottom=Side(style="thin", color="C0CCDD"),
        )
        def hdr_style(cell, txt, size=11, white=True):
            cell.value = txt
            cell.font  = Font(name="Arial", bold=True, size=size,
                              color="FFFFFF" if white else "0D1B2A")
            cell.fill  = hdr_fill if white else PatternFill("solid", fgColor="DCE4F0")
            cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
            cell.border = thin

        def data_row(ws, row_num, values, fill, bold=False, num_cols=None):
            for col, val in enumerate(values, 1):
                c = ws.cell(row=row_num, column=col, value=val)
                c.fill   = fill
                c.font   = Font(name="Arial", bold=bold, size=9)
                c.border = thin
                c.alignment = Alignment(horizontal="center", vertical="center")
                if num_cols and col in num_cols and isinstance(val, (int, float)):
                    c.number_format = '#,##0.00" ريال"'

        if sheet_type in ("bs", "is"):
            ws = wb.active
            ws.title = "Balance Sheet" if sheet_type=="bs" else "Income Statement"
            ws.sheet_view.rightToLeft = True
            ws.column_dimensions["A"].width = 28
            ws.column_dimensions["B"].width = 18
            ws.row_dimensions[1].height = 36

            if sheet_type == "bs":
                # عنوان
                ws.merge_cells("A1:B1")
                hdr_style(ws["A1"], f"قائمة المركز المالي  |  {date.today()}", size=13)
                ws.row_dimensions[1].height = 34

                rows_data = [
                    # (label, value, is_section, is_total)
                    ("الأصول", None, True, False),
                    (t["cash"], cash_balance, False, False),
                    (t["inventory"], inventory, False, False),
                    (t["total_assets"], total_assets, False, True),
                    ("", None, False, False),
                    ("الالتزامات", None, True, False),
                    (t["payables"], payables, False, False),
                    (t["total_liab"], total_liab, False, True),
                    ("", None, False, False),
                    ("حقوق الملكية", None, True, False),
                    (t["capital"], equity_capital, False, False),
                    (t["retained"], equity - equity_capital, False, False),
                    (t["total_equity"], equity, False, True),
                ]
                for i, (label, val, is_sec, is_tot) in enumerate(rows_data, 2):
                    ws.row_dimensions[i].height = 22
                    if is_sec:
                        c = ws.cell(row=i, column=1, value=label)
                        c.font  = Font(name="Arial", bold=True, size=10, color="FFFFFF")
                        c.fill  = sec_fill
                        c.alignment = Alignment(horizontal="right", vertical="center")
                        c.border = thin
                        ws.merge_cells(f"A{i}:B{i}")
                    else:
                        fill = tot_fill if is_tot else (row_fill1 if i%2==0 else row_fill2)
                        lc = ws.cell(row=i, column=1, value=label)
                        lc.font  = Font(name="Arial", bold=is_tot, size=9)
                        lc.fill  = fill
                        lc.border = thin
                        lc.alignment = Alignment(horizontal="right", vertical="center")
                        if val is not None:
                            vc = ws.cell(row=i, column=2, value=val)
                            vc.font  = Font(name="Arial", bold=is_tot, size=9)
                            vc.fill  = fill
                            vc.border = thin
                            vc.number_format = '#,##0.00" ريال"'
                            vc.alignment = Alignment(horizontal="center", vertical="center")

            else:  # is
                ws.merge_cells("A1:B1")
                hdr_style(ws["A1"], f"قائمة الدخل  |  {date.today()}", size=13)
                ws.row_dimensions[1].height = 34
                is_rows = [
                    ("الإيرادات", None, True, False),
                    (t["revenue"], revenue, False, False),
                    ("", None, False, False),
                    ("المصروفات", None, True, False),
                    ("تكلفة البضاعة المباعة", purchases, False, False),
                    (t["gross_profit"], gross_profit, False, True),
                    ("", None, False, False),
                    ("المصروفات التشغيلية", None, True, False),
                    ("مصروفات تشغيلية (تقديري)", other_exp, False, False),
                    ("", None, False, False),
                    (t["net_income"], net_income, False, True),
                ]
                for i, (label, val, is_sec, is_tot) in enumerate(is_rows, 2):
                    ws.row_dimensions[i].height = 22
                    if is_sec:
                        c = ws.cell(row=i, column=1, value=label)
                        c.font  = Font(name="Arial", bold=True, size=10, color="FFFFFF")
                        c.fill  = sec_fill
                        c.alignment = Alignment(horizontal="right", vertical="center")
                        c.border = thin
                        ws.merge_cells(f"A{i}:B{i}")
                    else:
