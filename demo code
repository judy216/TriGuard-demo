        _ln  = "Last Name *"        if _en_r else "الاسم الأخير *"
        _nid = "National ID *"      if _en_r else "رقم الهوية *"
        _em  = "Email *"            if _en_r else "البريد الإلكتروني *"
        _ph  = "Phone"              if _en_r else "رقم الجوال"
        _jt  = "Job Title *"        if _en_r else "المسمى الوظيفي *"
