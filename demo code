def record_journal_entry(po_id, username="system"):
    """تسجيل القيد المحاسبي عند اعتماد الفاتورة"""
    conn = get_connection()
    cur  = conn.cursor()
    cur.execute("SELECT item_name, quantity, unit_price FROM purchase_orders WHERE po_id=?", (po_id,))
    po = cur.fetchone()
    if not po:
        conn.close()
        return
    amount      = po[1] * po[2]
    entry_date  = str(date.today())
    description = f"شراء {po[0]} — اعتماد فاتورة"

    # قيد 1: المخزون (مدين) / الذمم الدائنة (دائن)
    cur.execute("""INSERT INTO journal_entries
        (po_id,entry_date,description,account_dr,amount_dr,account_cr,amount_cr,entry_type)
        VALUES (?,?,?,?,?,?,?,?)""",
        (po_id, entry_date, description,
         "المخزون / بضاعة", amount,
         "الذمم الدائنة (موردون)", amount,
         "balance_sheet"))

    # قيد 2: مصروف المشتريات (مدين) / البنك أو الدفع (دائن)
    cur.execute("""INSERT INTO journal_entries
        (po_id,entry_date,description,account_dr,amount_dr,account_cr,amount_cr,entry_type)
        VALUES (?,?,?,?,?,?,?,?)""",
        (po_id, entry_date, f"مصروف — {po[0]}",
         "مصروف المشتريات", amount,
         "النقدية / البنك", amount,
         "income_statement"))

    conn.commit()
    conn.close()
    log_action(username, "قيد محاسبي", f"أمر {po_id} — مبلغ {amount:,.2f} ريال")

