            "invoiced_price": ["invoiced_price",t["col_price"],"price","unit_price","سعر","سعر الوحدة"],
            "invoice_date":   ["invoice_date",t["col_date"],"date","invoice date",t["inv_date"],"تاريخ"],
        }
