    def refresh_audit_table(self):
        if not hasattr(self, "audit_tree"):
            return
        for r in self.audit_tree.get_children():
            self.audit_tree.delete(r)

        search    = getattr(self,"audit_search_var",None)
        search    = search.get().strip().lower() if search else ""
        filt_type = getattr(self,"audit_type_var",None)
        filt_type = filt_type.get() if filt_type else "الكل"

        conn = get_connection()
        cur  = conn.cursor()
        cur.execute("SELECT username,action,details,log_time FROM audit_log ORDER BY log_id DESC")
        rows = cur.fetchall()
        conn.close()

        # حساب الإحصائيات — دائماً بالعربية لأن قاعدة البيانات تخزن بالعربي
        total    = len(rows)
        login_c  = sum(1 for r in rows if r[1] == "تسجيل دخول")
        match_c  = sum(1 for r in rows if "مطابقة" in r[1])
        failed_c = sum(1 for r in rows if "فاشلة" in r[1])
        if hasattr(self,"audit_stat_vars"):
            self.audit_stat_vars["total"].set(str(total))
            self.audit_stat_vars["login"].set(str(login_c))
            self.audit_stat_vars["match"].set(str(match_c))
            self.audit_stat_vars["failed"].set(str(failed_c))

        # TAG_MAP يعتمد على القيم المخزنة بالعربي في قاعدة البيانات
        TAG_MAP = {
            "تسجيل دخول":        "login",
            "تشغيل المطابقة":    "match",
            "محاولة دخول فاشلة": "failed",
            "قيد محاسبي":        "journal",
        }

        # فلتر الكل — يقبل "الكل" و "All" كلاهما
        is_all = filt_type in ("الكل", "All", "")

        _en_audit = getattr(self,"_current_lang","ar")=="en"
        ACTION_EN = {
            "تسجيل دخول":         "Login",
            "تسجيل خروج":         "Logout",
            "تشغيل المطابقة":     "Run Matching",
            "قيد محاسبي":          "Journal Entry",
            "محاولة دخول فاشلة":  "Failed Login",
            "تسجيل حساب جديد":    "New Registration",
            "إضافة أمر شراء":     "Add PO",
            "حذف مستخدم":         "Delete User",
            "إلغاء أمر شراء":     "Cancel PO",
        }
        for row in rows:
            if search and search not in " ".join(str(v) for v in row).lower():
                continue
            if not is_all and row[1] != filt_type:
                continue
            tag = TAG_MAP.get(row[1], "default")
            # ترجمة نوع العملية عند العرض بالإنجليزي
            display_row = list(row)
            if _en_audit:
                display_row[1] = ACTION_EN.get(row[1], row[1])
            self.audit_tree.insert("", "end", values=display_row, tags=(tag,))

