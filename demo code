    def _cancel_inv_from_match(self):
        """إلغاء فاتورة الأمر المحدد من تبويب المطابقة"""
        t = TR.get(getattr(self,"_current_lang","ar"), TR["ar"])
        # اختر من الـ combo أو من الجدول
        po_text = self.match_po_combo.get().strip()
        if not po_text:
            # جرب من الجدول
            sel = self.match_tree.selection()
            if sel:
                po_text = str(self.match_tree.item(sel[0])["values"][0])
        if not po_text:
            messagebox.showwarning(t["warn_title"], "اختر أمر الشراء أولاً")
            return
        po_id = int(po_text.split("|")[0].strip()) if "|" in po_text else None
        if not po_id:
            # ابحث بالرقم
            conn = get_connection()
            row = conn.execute("SELECT po_id FROM purchase_orders WHERE po_number=?",
                               (po_text.split()[0],)).fetchone()
            conn.close()
            if not row:
                messagebox.showwarning(t["warn_title"], "لم يُعثر على الأمر")
                return
            po_id = row[0]
        # تحقق وجود فاتورة
        conn = get_connection()
        inv = conn.execute("SELECT invoice_number FROM supplier_invoices WHERE po_id=?",
                           (po_id,)).fetchone()
        conn.close()
        if not inv:
            messagebox.showwarning(t["warn_title"], "لا توجد فاتورة لهذا الأمر")
            return
        _msg = "إلغاء فاتورة " + str(inv[0]) + " للأمر?\nسيرجع الأمر لحالة بانتظار المطابقة."
        if not messagebox.askyesno("إلغاء الفاتورة", _msg):
            return
        conn = get_connection()
        try:
            # احذف الفاتورة + الاستلام + نتيجة المطابقة + أمر الشراء كله
            conn.execute("DELETE FROM supplier_invoices WHERE po_id=?", (po_id,))
            conn.execute("DELETE FROM goods_receipts WHERE po_id=?", (po_id,))
            conn.execute("DELETE FROM matching_results WHERE po_id=?", (po_id,))
            conn.execute("DELETE FROM journal_entries WHERE po_id=?", (po_id,))
            conn.execute("DELETE FROM purchase_orders WHERE po_id=?", (po_id,))
            conn.commit()
            log_action(self.username, "حذف كامل", f"تم حذف الأمر والفاتورة والاستلام: {inv[0]}")
            messagebox.showinfo(t["done"], "تم الحذف الكامل للأمر والفاتورة والاستلام ✅")
            self.refresh_match_table()
            self.refresh_inv_table()
            self.refresh_po_table()
            self.refresh_gr_table()
            self._refresh_po_combos()
        except Exception as e:
            messagebox.showerror(t["err_title"], str(e))
        finally:
            conn.close()

    def _run_match(self):
        t = TR.get(getattr(self,"_current_lang","ar"), TR["ar"])
        po_text = self.match_po_combo.get()
        if not po_text:
            messagebox.showwarning(t["warn_title"], "اختر أمر الشراء أولاً")
            return
        po_id = int(po_text.split("|")[0].strip())
        success, message = do_three_way_match(po_id)

        # عرض النتيجة في البطاقة
        self.result_text.config(state="normal")
        self.result_text.delete("1.0", "end")
        self.result_text.insert("end", message)
        self.result_text.config(
            state="disabled",
            fg=COLORS["success"] if success else COLORS["error"]
        )

        # حفظ في قاعدة البيانات
        conn = get_connection()
        conn.execute(
            "INSERT INTO matching_results (po_id,match_status,notes,checked_date) VALUES (?,?,?,?)",
            (po_id, "matched" if success else "mismatch", message, str(date.today()))
        )
        conn.commit()
        conn.close()
        log_action(self.username, "تشغيل المطابقة",
                   f"أمر: {po_text} — النتيجة: {'ناجح' if success else 'موقوف'}")
        # تسجيل القيد المحاسبي عند الاعتماد
        if success:
            record_journal_entry(po_id, self.username)

        # تحديث الجداول
        self.refresh_po_table()
        self.refresh_match_table()
        self.refresh_audit_table()
        self.root.after(300, self.refresh_finance)  # تحديث القوائم المالية فوراً

        if success:
            # جلب مبلغ الأمر لعرض التأثير
            conn3 = get_connection()
            c3    = conn3.cursor()
            c3.execute("SELECT quantity*unit_price FROM purchase_orders WHERE po_id=?", (po_id,))
            amt_row = c3.fetchone()
            conn3.close()
            amt = amt_row[0] if amt_row else 0
            self._show_finance_effect(True, amt, po_text)
        else:
            self._show_finance_effect(False, 0, po_text)

