    def _export_single_invoice_pdf(self, po, gr, inv, match, filepath):
        """تصدير فاتورة مفردة كـ PDF"""
        if not REPORTLAB_OK:
            return
        is_matched  = match and match[0] == "matched"
        status_text = ("Matched - Payment Approved" if is_matched
                       else ("Pending Match" if not match else "On Hold - Mismatch Detected"))
        doc   = SimpleDocTemplate(filepath, pagesize=A4,
                                  rightMargin=40, leftMargin=40,
                                  topMargin=40, bottomMargin=40)
        story = []
        W     = A4[0] - 80

        def hdr_tbl(data, col_w, bg_color):
            t = Table(data, colWidths=col_w)
            t.setStyle(TableStyle([
                ("BACKGROUND", (0,0), (-1,-1), bg_color),
                ("TEXTCOLOR",  (0,0), (-1,-1), rl_colors.white),
                ("FONTNAME",   (0,0), (-1,-1), "Helvetica-Bold"),
                ("FONTSIZE",   (0,0), (-1,-1), 11),
                ("ALIGN",      (0,0), (-1,-1), "CENTER"),
                ("VALIGN",     (0,0), (-1,-1), "MIDDLE"),
                ("ROWHEIGHT",  (0,0), (-1,-1), 28),
            ]))
            return t

        # عنوان
        story.append(hdr_tbl([["SUPPLIER INVOICE", po[1]]], [W*0.6, W*0.4],
                               rl_colors.HexColor("#7c6af7")))
        story.append(Spacer(1,6))

        # شريط الحالة
        sc = rl_colors.HexColor("#276749") if is_matched else rl_colors.HexColor("#c53030")
        story.append(hdr_tbl([[status_text]], [W], sc))
        story.append(Spacer(1,12))

        # معلومات
