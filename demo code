    def _draw_pie(self, parent, approved, on_hold, pending):
        """رسم مخطط دائري بسيط"""
        total = approved + on_hold + pending or 1
        cv = tk.Canvas(parent, width=200, height=160, bg="#ffffff", highlightthickness=0)
        cv.pack(pady=4)
        import math
        _en_pie = getattr(self,"_current_lang","ar")=="en"
        slices = [
            (approved, COLORS["success"], "Approved" if _en_pie else "معتمد"),
            (on_hold,  COLORS["error"],   "On Hold"  if _en_pie else "موقوف"),
            (pending,  COLORS["warning"], "Pending"  if _en_pie else "انتظار"),
        ]
        start = 0
        cx, cy, r = 90, 80, 65
        for val, color, label in slices:
            if val == 0:
                continue
            extent = (val / total) * 360
            cv.create_arc(cx-r, cy-r, cx+r, cy+r,
                          start=start, extent=extent,
                          fill=color, outline=COLORS["surface"], width=2)
            # نسبة النص
            mid_angle = math.radians(start + extent/2)
            tx = cx + (r*0.65) * math.cos(mid_angle)
            ty = cy - (r*0.65) * math.sin(mid_angle)
            pct = round(val/total*100)
            if pct > 5:
                cv.create_text(tx, ty, text=f"{pct}%",
                               font=("Arial",8,"bold"), fill="white")
            start += extent
        # مفتاح الألوان
        for i, (_, color, label) in enumerate(slices):
            cv.create_rectangle(155, 10+i*22, 170, 24+i*22, fill=color, outline="")
            cv.create_text(150, 17+i*22, text=label, anchor="e",
                           font=("Arial",8,"bold"), fill="#1e293b")

    def _draw_bar(self, parent):
        """رسم مخطط أعمدة للموردين"""
        conn = get_connection()
        cur  = conn.cursor()
        cur.execute("""SELECT supplier, SUM(quantity*unit_price)
                       FROM purchase_orders GROUP BY supplier
                       ORDER BY 2 DESC LIMIT 5""")
        data = cur.fetchall()
        conn.close()
        if not data:
            return
        cv = tk.Canvas(parent, width=280, height=160,
                       bg="#ffffff", highlightthickness=0)
        cv.pack(pady=4)
        max_val = max(v for _,v in data) or 1
        bar_w   = 30
        gap     = 12
        x0      = 20
        base_y  = 140
        bar_colors = [COLORS["accent"], COLORS["accent2"], COLORS["success"],
                      COLORS["warning"], COLORS["error"]]
        for i, (supplier, val) in enumerate(data):
            x      = x0 + i*(bar_w+gap)
            height = int((val/max_val) * 110)
            cv.create_rectangle(x, base_y-height, x+bar_w, base_y,
                                fill=bar_colors[i % len(bar_colors)], outline="")
            short = supplier[:6] + "…" if len(supplier)>6 else supplier
            cv.create_text(x+bar_w//2, base_y+8, text=short,
                           font=("Arial",7,"bold"), fill=COLORS["subtext"], angle=0)
