    def _import_gr_file(self):
        """استيراد سجلات الاستلام من CSV أو Excel"""
        import csv as _csv
        _t = TR.get(getattr(self,"_current_lang","ar"), TR["ar"])
        fp = filedialog.askopenfilename(
            title="اختر ملف سجلات الاستلام",
            filetypes=[
                ("CSV / Excel", "*.csv *.xlsx *.xls"),
                ("CSV", "*.csv"),
                ("Excel", "*.xlsx *.xls"),
                ("All", "*.*")
            ]
        )
        if not fp:
            return
        ok = skip = err = 0
        rows = []
        try:
            if fp.lower().endswith(".csv"):
                with open(fp, encoding="utf-8-sig", newline="") as f:
                    reader = _csv.DictReader(f)
                    rows = list(reader)
            else:
                try:
                    import openpyxl
                    wb = openpyxl.load_workbook(fp)
                    ws = wb.active
                    headers = [str(c.value).strip() if c.value else "" for c in next(ws.iter_rows(min_row=1, max_row=1))]
                    for row in ws.iter_rows(min_row=2, values_only=True):
                        rows.append({headers[i]: (str(v).strip() if v is not None else "") for i, v in enumerate(row)})
                except ImportError:
                    messagebox.showerror("خطأ", "تثبيت openpyxl مطلوب\npip install openpyxl")
                    return

            for r in rows:
                try:
                    po_num = (r.get("po_number") or r.get("رقم الأمر") or r.get("PO Number") or "").strip()
                    qty    = str(r.get("received_qty") or r.get("الكمية المستلمة") or r.get("qty") or "0").replace(",","")
                    dt     = (r.get("receipt_date") or r.get("تاريخ الاستلام") or r.get("date") or str(date.today())).strip()
                    if not po_num:
                        skip += 1
                        continue
                    # ابحث عن po_id
                    conn = get_connection()
                    row_po = conn.execute("SELECT po_id FROM purchase_orders WHERE po_number=?", (po_num,)).fetchone()
                    conn.close()
                    if not row_po:
                        skip += 1
                        continue
                    add_goods_receipt(row_po[0], int(float(qty or 0)), dt)
                    ok += 1
                except Exception as _ex:
                    err += 1
                    print(f"GR row error: {_ex}")

            self.refresh_gr_table()
            messagebox.showinfo(_t["done"],
                "تم استيراد " + str(ok) + " سجل استلام\nتجاوز: " + str(skip) + "\nأخطاء: " + str(err))
        except Exception as e:
            messagebox.showerror("خطأ في الاستيراد", str(e))

