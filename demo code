        self.root.after(100, lambda: self._show_page("dash"))
        # ── Auto-save كل 5 دقائق ──
        self._auto_save()
        self.root.after(200, self.refresh_match_table)
        self.root.after(300, self.refresh_inv_table)
        self.root.after(400, self.refresh_audit_table)
        self.root.after(500, self.refresh_finance)

