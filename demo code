# 0. تحميل خط أبشر (IBM Plex Sans Arabic / Noto Kufi Arabic)
# ──────────────────────────────────────────────
def load_arabic_font():
    """تحميل خط عربي احترافي مشابه لخط أبشر"""
    import urllib.request, os, sys
    
    font_candidates = [
        # Windows
        "C:/Windows/Fonts/NotoKufiArabic-Regular.ttf",
        "C:/Windows/Fonts/IBMPlexSansArabic-Regular.ttf",
        "C:/Windows/Fonts/Tajawal-Regular.ttf",
        "C:/Windows/Fonts/Cairo-Regular.ttf",
        # macOS
        "/Library/Fonts/NotoKufiArabic-Regular.ttf",
        "/System/Library/Fonts/Supplemental/NotoKufiArabic.ttf",
        # Linux
        "/usr/share/fonts/truetype/noto/NotoKufiArabic-Regular.ttf",
    ]
    
    for path in font_candidates:
        if os.path.exists(path):
            return path
    return None

ARABIC_FONT_PATH = load_arabic_font()

